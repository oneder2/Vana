{
  "name": "vana",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-vite-dev.mjs",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "check": "npm run lint && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:dev:android": "node scripts/run-tauri.mjs android dev",
    "tauri:build:android": "node scripts/run-tauri.mjs android build --target aarch64",
    "tauri:build:windows": "node scripts/run-tauri.mjs build --target x86_64-pc-windows-msvc",
    "tauri:build:android:full": "node scripts/run-tauri.mjs android build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "cargo test -j 2 --locked --manifest-path tests/native-core/Cargo.toml",
    "test:sync": "python3 scripts/test-supabase-protocol.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tiptap/extension-blockquote": "^3.15.3",
    "@tiptap/extension-bullet-list": "^3.15.3",
    "@tiptap/extension-code-block": "^3.15.3",
    "@tiptap/extension-heading": "^3.15.3",
    "@tiptap/extension-ordered-list": "^3.15.3",
    "@tiptap/extension-paragraph": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-underline": "^3.17.0",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "docx": "^9.5.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/html2pdf.js": "^0.10.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "vite": "^7.1.12"
  }
}
