[Unit]
Description=Refresh Vana website from latest stable GitHub release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gellar
Group=gellar
UMask=0022
ExecStart=/usr/bin/python3 /opt/vana-site/current/build.py --base /var/www/vana
WorkingDirectory=/opt/vana-site/current
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vana
